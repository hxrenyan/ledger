<!-- 松手可能已经不在圆按钮上（手指挪开、或按钮刚被 setData 刷新）。结束绑在蒙版上，松在哪都停。 -->
<view
  class="ap-mask"
  wx:if="{{show}}"
  bindtap="close"
  bindtouchend="finishRecord"
  bindtouchcancel="finishRecord"
>
  <view class="ap-sheet" catchtap="noop">
    <view class="ap-head">
      <view class="ap-title">{{title}}</view>
      <view class="ap-close" bindtap="close">关闭</view>
    </view>

    <!-- 待录 / 待拍 / 录音中 -->
    <block wx:if="{{state === 'idle' || state === 'recording'}}">
      <!-- 认出了字但没配解析模型：把原文摆出来，别让人以为是拍糊了 -->
      <view class="ap-notice" wx:if="{{state === 'idle' && parser === 'none'}}">
        <view class="ap-notice-title">认出了文字，但还整理不成流水</view>
        <view class="ap-notice-desc">{{aiError}}</view>
        <textarea class="ap-ocr-input" value="{{rawText}}" bindinput="onRawText" maxlength="8000" auto-height placeholder="识别出的文字"></textarea>
        <view class="ap-notice-actions">
          <button class="btn ghost" bindtap="copyRawText">复制文字</button>
          <button class="btn" disabled="{{!rawText}}" bindtap="reparseRawText">重新整理</button>
        </view>
      </view>

      <view class="ap-hint" wx:if="{{!(state === 'idle' && parser === 'none')}}">{{tip || hintText}}</view>

      <!-- 圆按钮里的文字始终是同一个节点。wx:if 换字会拆掉按下时的目标，松手事件就丢了。 -->
      <view
        class="ap-talk {{state === 'recording' ? 'on' : ''}}"
        wx:if="{{canSpeak || state === 'recording'}}"
        hover-class="none"
        bindtouchstart="startRecord"
        bindtouchmove="noop"
        bindtouchend="finishRecord"
        bindtouchcancel="finishRecord"
      >
        <text class="ap-talk-label">{{talkText}}</text>
      </view>

      <!-- 录音时仍占位。拿掉它浮层会变矮，按住的圆按钮会从手指底下挪走。 -->
      <view class="ap-photo {{state === 'recording' ? 'hold' : ''}}" wx:if="{{canPhoto && target !== 'note'}}" bindtap="pickPhoto">
        <view class="ap-photo-ico"></view>
        <text>拍一张小票 / 支付截图</text>
      </view>
      <view class="ap-cloud" wx:if="{{mode === 'photo' && canCloudRetry && state !== 'recording'}}" bindtap="cloudRetry">本机结果不准？云端再认一次</view>
    </block>

    <!-- 识别中 -->
    <view class="ap-busy" wx:if="{{state === 'busy'}}">
      <view class="ap-spin"></view>
      <view class="ap-hint">{{tip || '识别中…'}}</view>
    </view>

    <!-- 日历语音：先拆出日期和事情，核对后再记。不进流水 -->
    <block wx:if="{{state === 'note'}}">
      <view class="ap-hint">核对日期和事情，再记下。不进流水</view>
      <scroll-view class="ap-rows" scroll-y>
        <view class="ap-row" wx:for="{{noteItems}}" wx:key="key">
          <view class="ap-row-top">
            <picker class="ap-note-day" mode="date" value="{{item.day}}" data-i="{{index}}" bindchange="onNoteDay">
              <view class="ap-pick">{{item.dayText}}</view>
            </picker>
            <view class="ap-del" wx:if="{{noteItems.length > 1}}" data-i="{{index}}" bindtap="removeNote">删除</view>
          </view>
          <textarea
            class="ap-ocr-input"
            value="{{item.body}}"
            data-i="{{index}}"
            bindinput="onNoteInput"
            maxlength="200"
            auto-height
            placeholder="要记的事"
          ></textarea>
          <view class="ap-meta">{{item.count}}/200</view>
        </view>
      </scroll-view>
      <view class="ap-bad-reason" wx:if="{{noteError}}">{{noteError}}</view>
      <view class="ap-actions">
        <button class="btn ghost" disabled="{{noteBusy}}" bindtap="retry">重说</button>
        <button class="btn" disabled="{{!noteCanSave || noteBusy}}" bindtap="saveNote">记下</button>
      </view>
    </block>

    <!-- 核对 -->
    <block wx:if="{{state === 'editing'}}">
      <view class="ap-text" wx:if="{{text}}">“{{text}}”</view>
      <view class="ap-meta">
        共 {{items.length}} 行 · {{parser === 'ai' ? 'AI 解析' : '规则解析'}}
        <text wx:if="{{mode === 'photo' && ocrSource === 'local'}}"> · 本机识别</text>
        <text wx:elif="{{mode === 'photo' && ocrSource === 'cloud'}}"> · 云端识别</text>
        <text wx:if="{{aiError}}">（{{aiError}}）</text>
      </view>

      <scroll-view class="ap-rows" scroll-y>
        <view class="ap-row {{item.bad ? 'bad' : ''}}" wx:for="{{items}}" wx:key="row">
          <view class="ap-row-top">
            <view class="ap-dir {{item.direction}}" data-i="{{index}}" bindtap="onDirection">
              {{item.direction === 'income' ? '收入' : '支出'}}
            </view>
            <input
              class="ap-amount"
              type="text"
              value="{{item.amountText}}"
              data-i="{{index}}"
              bindinput="onAmount"
              placeholder="0.00"
            />
            <view class="ap-del" data-i="{{index}}" bindtap="removeRow">删除</view>
          </view>

          <view class="ap-picks">
            <picker mode="date" value="{{item.date}}" data-i="{{index}}" bindchange="onDate">
              <view class="ap-pick">{{item.date}}</view>
            </picker>
            <picker
              mode="selector"
              range="{{item.direction === 'income' ? incNames : expNames}}"
              value="{{item.catIndex}}"
              data-i="{{index}}"
              bindchange="pickCategory"
            >
              <view class="ap-pick">{{item.catName}}</view>
            </picker>
            <picker
              mode="selector"
              range="{{acctNames}}"
              value="{{item.acctIndex}}"
              data-i="{{index}}"
              bindchange="pickAccount"
            >
              <view class="ap-pick">{{item.acctName}}</view>
            </picker>
          </view>

          <view class="ap-switch">
            <view class="ap-sw {{item.isFavor ? '' : 'on'}}" data-i="{{index}}" data-favor="0" bindtap="setFavor">明细</view>
            <view class="ap-sw {{item.isFavor ? 'on' : ''}}" data-i="{{index}}" data-favor="1" bindtap="setFavor">人情</view>
          </view>
          <view class="ap-also" wx:if="{{item.isFavor}}">
            <text>同时记明细</text>
            <switch checked="{{item.alsoTx}}" data-i="{{index}}" color="#3b5bdb" bindchange="onAlsoTx" />
          </view>

          <input
            class="ap-note"
            value="{{item.noteText}}"
            data-i="{{index}}"
            bindinput="onNote"
            placeholder="备注"
          />

          <input
            wx:if="{{item.isFavor}}"
            class="ap-note"
            value="{{item.counterpartyText}}"
            data-i="{{index}}"
            bindinput="onCounterparty"
            placeholder="对方姓名"
          />

          <view class="ap-bad-reason" wx:if="{{item.bad}}">{{item.reason || '这一行没解析出来'}}</view>
        </view>
      </scroll-view>

      <view class="ap-cloud" wx:if="{{mode === 'photo' && canCloudRetry}}" bindtap="cloudRetry">本机结果不准？云端再认一次</view>
      <view class="ap-actions">
        <button class="btn ghost" bindtap="retry">{{mode === 'photo' ? '换一张' : '重说'}}</button>
        <button class="btn" bindtap="commit">保存 {{items.length}} 笔</button>
      </view>
    </block>
  </view>
</view>
