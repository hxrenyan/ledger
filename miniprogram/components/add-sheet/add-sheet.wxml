<view class="as-mask" wx:if="{{show}}" bindtap="close">
  <view class="as-sheet" catchtap="noop">
    <view class="as-title">记点什么</view>
    <view class="as-grid">
      <view class="as-item" wx:for="{{items}}" wx:key="type" data-type="{{item.type}}" bindtap="pick">
        <view class="as-ico {{item.color}}">{{item.icon}}</view>
        <view class="as-label">{{item.label}}</view>
      </view>
    </view>
    <view class="as-cancel" bindtap="close">取消</view>
  </view>
</view>
