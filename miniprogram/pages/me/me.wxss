.card.user {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-lg {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: #eef0ff;
  color: #3b5bdb;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 112rpx;
  text-align: center;
  flex: none;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.nick {
  font-size: 36rpx;
  font-weight: 600;
}

.arrow {
  color: #8e8e93;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}
