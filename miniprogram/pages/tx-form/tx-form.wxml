<view class="page entry">
  <view class="kind">
    <view class="k {{kind === 'expense' ? 'on expense' : ''}}" data-kind="expense" bindtap="setKind">支出</view>
    <view class="k {{kind === 'income' ? 'on income' : ''}}" data-kind="income" bindtap="setKind">收入</view>
    <view class="k {{kind === 'transfer' ? 'on plain' : ''}}" data-kind="transfer" bindtap="setKind">转账</view>
  </view>

  <view class="card">
    <view class="amount-wrap">
      <text class="cny">¥</text>
      <input
        class="input amount-input"
        type="text"
        value="{{amountText}}"
        bindinput="onAmount"
        placeholder="0.00"
        placeholder-class="ph"
        focus="{{!id}}"
      />
    </view>
    <view class="tip">支持算式，例如 12+8、3*4</view>
  </view>

  <view class="card">
    <view class="pick-row">
      <view class="pick" wx:if="{{kind !== 'transfer'}}">
        <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="pickCategory" disabled="{{!categoryNames.length}}">
          <view class="pick-box">
            <text class="pick-k">分类</text>
            <view class="pick-v">
              <text class="val">{{categoryName}}</text>
              <text class="caret">▾</text>
            </view>
          </view>
        </picker>
      </view>
      <view class="pick" wx:else>
        <picker mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="pickAccount">
          <view class="pick-box">
            <text class="pick-k">转出</text>
            <view class="pick-v">
              <text class="val">{{accountName}}</text>
              <text class="caret">▾</text>
            </view>
          </view>
        </picker>
      </view>

      <view class="pick">
        <view class="pick-box">
          <text class="pick-k">日期</text>
          <view class="pick-v">
            <picker mode="date" value="{{date}}" bindchange="onDate">
              <text class="val">{{dateText}}</text>
            </picker>
            <picker mode="time" value="{{clock}}" bindchange="onClock">
              <text class="val clock">{{clock}}</text>
            </picker>
          </view>
        </view>
      </view>

      <view class="pick" wx:if="{{kind !== 'transfer'}}">
        <picker mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="pickAccount">
          <view class="pick-box">
            <text class="pick-k">账户</text>
            <view class="pick-v">
              <text class="val">{{accountName}}</text>
              <text class="caret">▾</text>
            </view>
          </view>
        </picker>
      </view>
      <view class="pick" wx:else>
        <picker mode="selector" range="{{accountNames}}" value="{{toAccountIndex}}" bindchange="pickToAccount">
          <view class="pick-box">
            <text class="pick-k">转入</text>
            <view class="pick-v">
              <text class="val {{toAccountId ? '' : 'ph'}}">{{toAccountName}}</text>
              <text class="caret">▾</text>
            </view>
          </view>
        </picker>
      </view>
    </view>
    <view class="empty" wx:if="{{kind !== 'transfer' && !categoryNames.length}}">还没有分类，去「我的 → 分类」加一个</view>
  </view>

  <view class="card">
    <view class="field" style="margin-bottom: 0">
      <view class="label">备注</view>
      <input class="input" value="{{note}}" bindinput="onNote" placeholder="比如：和同事午饭" placeholder-class="ph" />
    </view>
  </view>

  <view class="card">
    <view class="pair">
      <view class="pair-item">
        <text>不计入统计</text>
        <switch checked="{{excluded}}" color="#3b5bdb" bindchange="onExcluded" />
      </view>
      <view class="pair-item" wx:if="{{!id}}">
        <text>继续下一笔</text>
        <switch checked="{{keepGoing}}" color="#3b5bdb" bindchange="onKeepGoing" />
      </view>
    </view>
    <view class="row" style="padding-bottom: 0">
      <view class="grow title">{{hasReceipt ? '收据已上传' : '收据'}}</view>
      <view class="text-btn" wx:if="{{hasReceipt}}" bindtap="viewReceipt">查看</view>
      <view class="text-btn" wx:if="{{hasReceipt}}" bindtap="deleteReceipt">删除</view>
      <view class="text-btn" bindtap="pickReceipt">{{hasReceipt ? '更换' : '上传'}}</view>
    </view>
  </view>
</view>

<view class="save-bar">
  <view class="err" wx:if="{{err}}">{{err}}</view>
  <view class="actions">
    <button class="btn danger" wx:if="{{id}}" bindtap="remove">删除</button>
    <button class="btn" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
  </view>
</view>
