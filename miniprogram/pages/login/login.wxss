.login {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 104rpx 52rpx 64rpx;
  background: #f4f6f3;
}

.brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 112rpx;
}

.logo {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #315c4a;
  color: #fff;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.brand-copy {
  min-width: 0;
}

.app-name {
  font-size: 34rpx;
  font-weight: 650;
  color: #202a25;
}

.slogan {
  margin-top: 6rpx;
  color: #758078;
  font-size: 23rpx;
}

.login-content {
  width: 100%;
}

.welcome {
  color: #202a25;
  font-size: 42rpx;
  font-weight: 650;
}

.subtitle {
  margin: 12rpx 0 56rpx;
  color: #758078;
  font-size: 27rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  color: #49544d;
  font-size: 24rpx;
}

.input {
  height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #dce3dd;
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
}

.btn {
  width: 100%;
  min-height: 96rpx;
  height: 96rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 12rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.btn::after {
  border: 0;
}

.btn.wechat {
  background: #21834e;
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(33, 131, 78, 0.16);
}

.btn.secondary {
  margin-top: 4rpx;
  background: #fff;
  border: 2rpx solid #dce3dd;
  color: #34483d;
  box-shadow: none;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  color: #7a847d;
  font-size: 22rpx;
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 38rpx 0 24rpx;
  color: #929c95;
  font-size: 22rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #dfe5df;
}

.alt,
.browse {
  padding: 22rpx 0 4rpx;
  text-align: center;
  color: #315c4a;
  font-size: 26rpx;
}

.browse {
  padding-top: 34rpx;
  color: #7a847d;
  font-size: 24rpx;
}

.ph {
  color: #b8b8bd;
}

/* 环境逃生口：指向非线上时才出现。 */
.env {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: #fff4e5;
  border: 2rpx solid #ffd8a8;
  border-radius: 20rpx;
}

.env-tip {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.env-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a5a00;
}

.env-desc {
  font-size: 22rpx;
  color: #a97c2f;
  margin-top: 6rpx;
}

.env-btn {
  flex: none;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #d97706;
  color: #fff;
  font-size: 26rpx;
}
