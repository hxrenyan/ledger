.login {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 72rpx 36rpx 48rpx;
  background: var(--bg);
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 8rpx 56rpx;
}

.logo {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: var(--brand);
  color: #fff;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.brand-copy {
  min-width: 0;
}

.app-name {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--text);
}

.slogan {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.login-content {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--card);
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 40, 0.04);
}

.welcome {
  color: var(--text);
  font-size: 38rpx;
  font-weight: 650;
}

.subtitle {
  margin: 10rpx 0 40rpx;
  color: var(--muted);
  font-size: 27rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  color: var(--text);
  font-size: 24rpx;
}

.input {
  height: 92rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
}

.btn {
  width: 100%;
  min-height: 96rpx;
  height: 96rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 12rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.btn::after {
  border: 0;
}

.btn.wechat {
  background: var(--brand);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(59, 91, 219, 0.16);
}

.btn.secondary {
  margin-top: 4rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  color: var(--brand);
  box-shadow: none;
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 38rpx 0 24rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.divider::before,
.divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: var(--line);
}

.alt,
.browse {
  padding: 22rpx 0 4rpx;
  text-align: center;
  color: var(--brand);
  font-size: 26rpx;
}

.browse {
  padding-top: 34rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.ph {
  color: #b8b8bd;
}

/* 环境逃生口：指向非线上时才出现。 */
.env {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 40rpx;
}

.env-tip {
  flex: 1;
  min-width: 0;
  margin-right: 0;
  padding: 20rpx 24rpx;
  background: #fff4e5;
  border: 2rpx solid #ffd8a8;
  border-radius: 16rpx;
}

.env-btn {
  flex: none;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
}

.env-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a5a00;
}

.env-desc {
  overflow-wrap: anywhere;
  font-size: 22rpx;
  color: #a97c2f;
  margin-top: 6rpx;
}
