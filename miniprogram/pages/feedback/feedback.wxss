.feedback-box {
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 1rpx solid #ececef;
  border-radius: 24rpx;
  background: #fff;
  font-size: 30rpx;
  line-height: 1.5;
}

.entry {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.entry:last-child {
  border-bottom: none;
}
