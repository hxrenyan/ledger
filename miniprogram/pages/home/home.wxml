<view class="page with-fab">
  <!-- 顶栏：左侧年月切换药丸（支持左右切月与双列年月滚轮），右侧视图切换 -->
  <view class="top-bar">
    <month-nav
      wx:if="{{!guest}}"
      class="top-month"
      compact
      hide-back
      month="{{month}}"
      bind:change="onMonthChange"
    />
    <view class="view-switch {{guest ? 'full' : ''}}">
      <view class="vs-item {{view === 'list' ? 'on' : ''}}" data-v="list" bindtap="switchView">流水</view>
      <view class="vs-item {{view === 'cal' ? 'on' : ''}}" data-v="cal" bindtap="switchView">日历</view>
      <view class="vs-item {{view === 'stat' ? 'on' : ''}}" data-v="stat" bindtap="switchView">统计</view>
    </view>
  </view>

  <!-- 近月快捷切换条：点选直达近 6 个月；跳到更早历史月份时自动展示前后相邻月 +「回到本月」 -->
  <view class="month-strip" wx:if="{{!guest}}">
    <view
      class="m-chip {{qm.on ? 'on' : ''}} {{qm.isBack ? 'back' : ''}}"
      wx:for="{{quickMonths}}"
      wx:for-item="qm"
      wx:key="month"
      data-month="{{qm.month}}"
      bindtap="tapQuickMonth"
    >
      {{qm.label}}
    </view>
  </view>

  <!-- 汇总：收入 / 支出 / 结余 -->
  <view class="summary summary-three" wx:if="{{!guest}}">
    <view class="s">
      <view class="k">收入</view>
      <view class="v income">{{incomeText}}</view>
    </view>
    <view class="s">
      <view class="k">支出</view>
      <view class="v expense">{{expenseText}}</view>
    </view>
    <view class="s">
      <view class="k">结余</view>
      <view class="v {{netClass}}">{{netText}}</view>
    </view>
  </view>

  <view class="card budget-card" wx:if="{{!guest && budgetText}}" bindtap="openBudget">
    <view class="budget-head">
      <view class="title">本月预算</view>
      <view class="muted">{{budgetText}} ›</view>
    </view>
    <view class="bar {{budgetOver ? 'over' : ''}}">
      <view class="i" style="width: {{budgetPercent}}%"></view>
    </view>
    <view class="tip" style="margin-bottom: 0">已用 {{budgetPercent}}%{{budgetOver ? ' · 已超出预算' : ''}}</view>
  </view>

  <!-- 搜索与筛选（常驻紧凑工具条） -->
  <view class="toolbar" wx:if="{{view === 'list' && !guest}}">
    <view class="search-bar">
      <input
        class="search-input"
        value="{{q}}"
        bindinput="onSearch"
        bindconfirm="doSearch"
        confirm-type="search"
        placeholder="搜索备注关键词…"
        placeholder-class="ph"
      />
      <view class="search-clear" wx:if="{{q}}" bindtap="clearSearch">×</view>
      <view class="search-btn" bindtap="doSearch">搜索</view>
    </view>

    <view class="filter-bar">
      <view class="kind-pills">
        <view class="pill-chip {{kindFilter === 'all' ? 'on' : ''}}" data-kind="all" bindtap="setKindFilter">全部</view>
        <view class="pill-chip {{kindFilter === 'expense' ? 'on' : ''}}" data-kind="expense" bindtap="setKindFilter">支出</view>
        <view class="pill-chip {{kindFilter === 'income' ? 'on' : ''}}" data-kind="income" bindtap="setKindFilter">收入</view>
        <view class="pill-chip {{kindFilter === 'transfer' ? 'on' : ''}}" data-kind="transfer" bindtap="setKindFilter">转账</view>
      </view>
      <view class="filter-picks">
        <picker mode="selector" range="{{accountNames}}" value="{{accountFilterIndex}}" bindchange="pickAccount">
          <view class="filter-pill {{accountId ? 'on' : ''}}">
            <text class="val">{{accountId ? accountFilterText : '账户'}}</text>
            <text class="caret">▾</text>
          </view>
        </picker>
        <picker mode="selector" range="{{categoryNames}}" value="{{categoryFilterIndex}}" bindchange="pickCategory">
          <view class="filter-pill {{categoryId ? 'on' : ''}}">
            <text class="val">{{categoryId ? categoryFilterText : '分类'}}</text>
            <text class="caret">▾</text>
          </view>
        </picker>
        <view class="filter-reset" wx:if="{{hasFilter}}" bindtap="resetFilter">重置</view>
      </view>
    </view>
  </view>

  <!-- 流水视图 -->
  <block wx:if="{{view === 'list'}}">
    <view class="empty" wx:if="{{loading}}">加载中…</view>
    <view class="card empty-card" wx:elif="{{empty}}">
      <view class="empty-text">{{hasFilter ? '没有匹配的流水记录' : '这个月还没有记录'}}</view>
      <view class="empty-actions">
        <button class="btn ghost compact" wx:if="{{hasFilter}}" bindtap="resetFilter">清除筛选</button>
        <block wx:else>
          <button class="btn compact" bindtap="quickAddTx">＋ 记一笔</button>
          <button class="btn ghost compact" wx:if="{{canAi}}" bindtap="openVoice">智能记账</button>
        </block>
      </view>
    </view>

    <view class="card group-card" wx:for="{{groups}}" wx:key="key">
      <view class="group-head">
        <view class="group-date">{{item.label}}</view>
        <view class="group-sum">{{item.sumText}}</view>
      </view>
      <view
        class="row tx-row"
        wx:for="{{item.items}}"
        wx:for-item="tx"
        wx:key="id"
        data-id="{{tx.id}}"
        bindtap="editTx"
        bindlongpress="deleteTx"
      >
        <view class="grow">
          <view class="tx-title-line">
            <text class="title">{{tx.category || tx.kindText}}</text>
            <text class="tx-badge muted" wx:if="{{tx.excluded}}">不计入</text>
            <text class="tx-badge brand" wx:if="{{tx.hasReceipt}}">收据</text>
          </view>
          <view class="muted tx-sub">{{tx.account}}<text wx:if="{{tx.toAccount}}"> → {{tx.toAccount}}</text> · {{tx.clock}}<text wx:if="{{tx.note}}"> · {{tx.note}}</text></view>
        </view>
        <view class="tx-right">
          <view class="amount {{tx.kind === 'income' ? 'income' : (tx.kind === 'expense' ? 'expense' : '')}}">{{tx.amountText}}</view>
          <view class="arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 日历视图（支持左右滑动日历切换上/下月） -->
  <block wx:if="{{view === 'cal'}}">
    <view class="cal" bindtouchstart="onCalTouchStart" bindtouchend="onCalTouchEnd">
      <view class="w" wx:for="{{calWeek}}" wx:key="*this">{{item}}</view>
      <!-- wx:for-item 必须显式写：block 的默认变量名是 item，写成 cell 会全部取到 undefined -->
      <block wx:for="{{cells}}" wx:for-item="cell" wx:key="key">
        <view class="d blank" wx:if="{{cell.blank}}"></view>
        <view
          class="d {{cell.has ? 'has' : ''}} {{cell.date === selectedDay ? 'on' : ''}} {{cell.date === todayISO ? 'today' : ''}}"
          wx:else
          data-date="{{cell.date}}"
          bindtap="tapDay"
        >
          {{cell.day}}
        </view>
      </block>
    </view>

    <view class="empty" wx:if="{{empty && !selectedDay}}">这个月还没有记录，点右下角 + 记一笔（左右滑动日历可切月份）</view>

    <view class="card day-card" wx:if="{{selectedDay}}">
      <view class="day-head">
        <view class="grow">
          <view class="title">{{dayTitle}}</view>
          <view class="muted" wx:if="{{daySumText}}">{{daySumText}}</view>
        </view>
        <view class="day-actions">
          <view class="pill-action" bindtap="addTxOnSelectedDay">＋ 记这天</view>
          <view class="text-btn" bindtap="clearDay">收起</view>
        </view>
      </view>
      <view class="empty" wx:if="{{!dayItems.length}}">{{empty ? '这个月还没有记录，点「＋ 记这天」记一笔' : '这天没有记录，点右上角可补记'}}</view>
      <view
        class="row tx-row"
        wx:for="{{dayItems}}"
        wx:for-item="tx"
        wx:key="id"
        data-id="{{tx.id}}"
        bindtap="editTx"
        bindlongpress="deleteTx"
      >
        <view class="grow">
          <view class="tx-title-line">
            <text class="title">{{tx.category || tx.kindText}}</text>
            <text class="tx-badge muted" wx:if="{{tx.excluded}}">不计入</text>
            <text class="tx-badge brand" wx:if="{{tx.hasReceipt}}">收据</text>
          </view>
          <view class="muted tx-sub">{{tx.account}}<text wx:if="{{tx.toAccount}}"> → {{tx.toAccount}}</text> · {{tx.clock}}<text wx:if="{{tx.note}}"> · {{tx.note}}</text></view>
        </view>
        <view class="tx-right">
          <view class="amount {{tx.kind === 'income' ? 'income' : (tx.kind === 'expense' ? 'expense' : '')}}">{{tx.amountText}}</view>
          <view class="arrow">›</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 统计视图 -->
  <block wx:if="{{view === 'stat'}}">
    <view class="card">
      <view class="stat-line">
        <text>{{monthText}}结余</text>
        <text>收入 {{incomeText}} · 支出 {{expenseText}}</text>
      </view>
      <view class="stat-net {{netClass}}">{{netText}}</view>

      <view class="stat-h">
        <view class="h2" style="margin: 0">近 6 个月（点柱切换月份）</view>
        <view class="muted">绿收 / 红支</view>
      </view>
      <view class="chart">
        <view
          class="col {{item.month === month ? 'on' : ''}}"
          wx:for="{{trend}}"
          wx:key="month"
          data-month="{{item.month}}"
          bindtap="tapTrendMonth"
        >
          <view class="bars">
            <view class="b income" style="height: {{item.incomeH}}%"></view>
            <view class="b expense" style="height: {{item.expenseH}}%"></view>
          </view>
          <view class="x">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="stat-h" style="margin-bottom: 12rpx">
        <view class="h2" style="margin: 0">分类排行</view>
        <view class="muted" wx:if="{{statCats.length}}">点分类查看明细</view>
      </view>
      <view class="empty" wx:if="{{!statCats.length}}">本月还没有收支</view>
      <view
        class="cat"
        wx:for="{{statCats}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="tapStatCategory"
      >
        <view class="top">
          <view>{{item.name}}<text class="{{item.kind === 'income' ? 'income' : 'expense'}}"> · {{item.kind === 'income' ? '收入' : '支出'}}</text></view>
          <view class="tx-right">
            <view class="amount {{item.kind === 'income' ? 'income' : 'expense'}}">{{item.amountText}}</view>
            <view class="arrow">›</view>
          </view>
        </view>
        <view class="bar {{item.kind === 'income' ? 'income' : (item.over ? 'over' : '')}}">
          <view class="i" style="width: {{item.width}}%"></view>
        </view>
        <view class="cat note" wx:if="{{item.shareText || item.budgetText}}">{{item.shareText}}<text wx:if="{{item.budgetText}}"> · {{item.budgetText}}</text></view>
      </view>
    </view>
  </block>
</view>

<view class="fab" bindtap="openAdd">+</view>

<add-sheet show="{{showAdd}}" canAi="{{canAi}}" bind:close="closeAdd" bind:select="onAddSelect" />
<ai-panel
  show="{{showVoice}}"
  scope="tx"
  can-speak="{{canSpeak}}"
  can-photo="{{canPhoto}}"
  bind:close="closeVoice"
  bind:done="onVoiceDone"
/>
