.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 4rpx 0 16rpx;
}

.top-month {
  flex: none;
}

.view-switch {
  display: inline-flex;
  align-items: center;
  background: #eceef5;
  border-radius: 999rpx;
  padding: 6rpx;
  gap: 4rpx;
  flex: none;
}

.view-switch.full {
  width: 100%;
}

.vs-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--muted);
  white-space: nowrap;
}

.vs-item.on {
  background: #fff;
  color: var(--text);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(20, 20, 40, 0.06);
}

.month-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.m-chip {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  color: var(--muted);
  font-size: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(20, 20, 40, 0.04);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-chip.on {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(59, 91, 219, 0.25);
}

.m-chip.back {
  flex: 1.25;
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.summary-three {
  margin-top: 0;
}

.summary-three .s {
  padding: 20rpx 16rpx;
}

.summary-three .s .v {
  font-size: 32rpx;
}

.budget-card {
  margin-bottom: 24rpx;
}

.budget-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.toolbar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 12rpx 0 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 40, 0.05);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 28rpx;
}

.search-clear {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  color: var(--muted);
  font-size: 36rpx;
  flex: none;
}

.search-btn {
  flex: none;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.kind-pills {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pill-chip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #eceef5;
  color: var(--muted);
  font-size: 24rpx;
}

.pill-chip.on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.filter-picks {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: auto;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  max-width: 200rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--text);
}

.filter-pill.on {
  border-color: var(--brand);
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.filter-pill .val {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-pill .caret {
  font-size: 20rpx;
  color: var(--muted);
  flex: none;
}

.filter-reset {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
  padding: 8rpx 8rpx;
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-text {
  color: var(--muted);
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.empty-actions .btn + .btn {
  margin-top: 0;
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.group-date {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.group-sum {
  font-size: 24rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.tx-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tx-badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
}

.tx-badge.muted {
  background: #eceef5;
  color: var(--muted);
}

.tx-badge.brand {
  background: var(--brand-soft);
  color: var(--brand);
}

.tx-sub {
  margin-top: 6rpx;
}

.tx-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.arrow {
  color: var(--muted);
  font-size: 28rpx;
}

.day-card {
  margin-top: 24rpx;
}

.day-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.day-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: none;
}

.pill-action {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
}

.ph {
  color: #b8b8bd;
}
