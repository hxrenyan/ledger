.amount-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cny {
  font-size: 44rpx;
  font-weight: 600;
  color: #8e8e93;
}

.amount-wrap .amount-input {
  flex: 1;
  border: 0;
  padding-left: 0;
}

.ph {
  color: #b8b8bd;
}

.pick-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.pick {
  flex: 1;
  min-width: 0;
}

.pick-box {
  height: 100%;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: #f4f5f8;
}

.pick-k {
  display: block;
  margin-bottom: 8rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.2;
}

.pick-v {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.pick-v .val {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
}

.pick-v .val.ph,
.pick-v .caret {
  flex: none;
  color: #8e8e93;
  font-weight: 400;
}

.pick-v .caret {
  font-size: 22rpx;
}

.occasion-input {
  margin-top: 16rpx;
}

.add-contact {
  display: inline-block;
  margin-top: 16rpx;
}

.pair {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.pair-item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 26rpx;
}

.pair-item switch {
  transform: scale(0.82);
  transform-origin: right center;
}
