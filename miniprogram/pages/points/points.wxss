.balance-card {
  margin-bottom: 24rpx;
}

.balance {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
  margin: 8rpx 0;
}

.entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.entry:last-child {
  border-bottom: none;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.delta {
  flex: none;
  font-weight: 600;
}
