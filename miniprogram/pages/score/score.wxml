<view class="page score-page">
    <view class="card guest-panel" wx:if="{{guest}}">
    <view class="section-title">一起记分</view>
    <view class="muted">登录后加入房间，系统会自动创建你的玩家身份。</view>
    <button class="btn compact guest-button" bindtap="goLogin">登录并加入</button>
  </view>
  <block wx:else>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <block wx:if="{{!room}}">
      <view class="card intro">
        <view class="intro-kicker">临时房间 · 独立于账本</view>
        <view class="section-title intro-title">一起记分</view>
        <view class="muted intro-copy">每笔转分一增一减，房间总分保持不变。</view>
        <view class="intro-actions">
          <button class="btn compact" bindtap="createRoom">创建房间</button>
          <button class="btn ghost compact" bindtap="joinCode">输入邀请码</button>
        </view>
      </view>
      <view class="muted section-note">每人只能参与一个进行中的房间 · 最多10人</view>
      <view class="card room-row" wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="openRoom">
        <view class="grow"><view class="section-title">{{item.name}}</view><view class="muted">{{item.playerCount}} 位玩家 · {{item.status === 'active' ? '进行中' : '已结束'}}</view></view>
        <view class="arrow">›</view>
      </view>
      <view class="empty" wx:if="{{!loading && !rooms.length}}">还没有记分房间</view>
    </block>
    <block wx:else>
      <view class="room-heading">
        <view class="room-title-wrap">
          <view class="room-title-line"><view class="room-title">{{room.name}}</view><view class="status {{room.status}}">{{room.status === 'active' ? '进行中' : '已结束'}}</view></view>
          <view class="room-caption">{{playerCount}} 位玩家 · 总分 {{totalScore}}{{room.status === 'active' ? '' : ' · 结果保留 7 天'}}</view>
        </view>
        <button class="menu-button" bindtap="roomMenu">···</button>
      </view>
      <view class="invite-panel" wx:if="{{room.status === 'active'}}">
        <view class="invite-copy" bindtap="copyCode"><text class="invite-label">邀请码</text><text class="code">{{room.invite_code}}</text><text class="copy-hint">复制</text></view>
        <button class="share-button" open-type="share">邀请好友</button>
      </view>
      <view class="hint" wx:if="{{room.status === 'active' && transferPlayers.length > 1}}">点玩家即可给 TA 转分</view>
      <view class="card players-card">
        <view class="player-row {{item.disabled ? 'disabled' : ''}}" wx:for="{{room.players}}" wx:key="id" data-id="{{item.id}}" bindtap="openTransfer" hover-class="{{room.status === 'active' && !item.disabled ? 'row-hover' : 'none'}}">
          <view class="player-name">{{item.name}}<text class="mine" wx:if="{{item.user_id === userId}}">我</text><text class="disabled-label" wx:if="{{item.disabled}}">已停用</text></view>
          <view class="player-score {{item.score < 0 ? 'negative' : (item.score > 0 ? 'positive' : '')}}">{{item.score > 0 ? '+' : ''}}{{item.score}}</view>
          <view class="row-more" wx:if="{{room.status === 'active' && owner}}" data-id="{{item.id}}" catchtap="managePlayer">···</view>
        </view>
        <view class="add-row" wx:if="{{room.status === 'active' && owner && playerCount < 10}}" bindtap="addPlayer">＋ 添加玩家</view>
        <view class="players-empty muted" wx:if="{{!playerCount}}">暂无玩家</view>
      </view>
      <view class="section-head"><view class="section-title">转分记录</view></view>
      <view class="card history-card">
        <view class="history-row" wx:for="{{entries}}" wx:key="id">
          <view class="history-names"><text wx:if="{{item.from_player_name}}">{{item.from_player_name}}<text class="flow-arrow"> → </text></text>{{item.player_name}}</view>
          <view class="history-amount">{{item.delta}}</view>
          <view class="history-meta">{{item.created_by_name}} · {{item.timeText}}</view>
        </view>
        <view class="empty" wx:if="{{!entries.length}}">还没有转分记录</view>
        <view class="more muted" wx:if="{{historyLoading}}">正在加载更早记录</view>
        <view class="more muted" wx:elif="{{next}}">下滑加载更早记录</view>
      </view>
      <view class="section-note muted" wx:if="{{room.status === 'active'}}">24 小时无操作自动结束 · 查看和同步不延长时间</view>
      <view class="bottom-bar" wx:if="{{room.status === 'active' && transferPlayers.length > 1}}">
        <button class="bottom-button" bindtap="openTransfer">转分</button>
        <button class="bottom-button proxy" wx:if="{{owner}}" data-mode="proxy" bindtap="openTransfer">代转</button>
      </view>
    </block>
  </block>
</view>
<view class="entry-mask" wx:if="{{transferOpen}}" bindtap="closeEntry">
  <view class="entry-sheet" catchtap="noop">
    <view class="sheet-head"><view class="section-title">{{proxy ? '代转分' : '转分'}}</view><view class="sheet-close" bindtap="closeEntry">✕</view></view>
    <block wx:if="{{proxy}}">
      <view class="pick-label">从谁转出</view>
      <view class="chips">
        <view class="chip {{item.id === fromPlayerId ? 'from' : ''}}" wx:for="{{transferPlayers}}" wx:key="id" data-id="{{item.id}}" bindtap="pickFrom">{{item.name}}</view>
      </view>
    </block>
    <view class="pick-label">{{proxy ? '转给谁' : '转给'}}</view>
    <view class="chips">
      <view class="chip {{item.id === toPlayerId ? 'to' : ''}}" wx:for="{{transferPlayers}}" wx:key="id" wx:if="{{proxy || item.id !== fromPlayerId}}" data-id="{{item.id}}" bindtap="pickTo">{{item.name}}</view>
    </view>
    <view class="amount-input-row"><input class="score-input" type="number" value="{{delta}}" bindinput="inputDelta" disabled="{{saving}}" focus="{{autoFocus}}" placeholder="输入分数" /><text class="amount-unit">分</text></view>
    <view class="quick-amounts">
      <view class="quick {{delta == item ? 'active' : ''}}" wx:for="{{amounts}}" wx:key="*this" data-value="{{item}}" bindtap="quickAmount">{{item}}</view>
    </view>
    <button class="confirm-button" bindtap="saveEntry" disabled="{{saving || !fromPlayerId || !toPlayerId || !delta}}">{{saving ? '提交中…' : pending ? '重试确认' : (toPlayerName && delta ? (proxy ? fromPlayerName + ' → ' + toPlayerName : '转给 ' + toPlayerName) + '  ' + delta + ' 分' : '确认转分')}}</button>
  </view>
</view>
