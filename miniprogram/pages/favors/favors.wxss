.summary .s {
  padding: 20rpx 16rpx;
}

.summary .s .v {
  font-size: 32rpx;
}

.soon-wrap {
  margin: 0 0 20rpx;
}

.soon-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 8rpx 12rpx;
}

.soon-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
}

.soon-manage {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.soon {
  width: 100%;
  height: 156rpx;
  white-space: nowrap;
}

.soon-card {
  display: inline-block;
  vertical-align: top;
  width: 300rpx;
  height: 144rpx;
  margin-right: 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 40, 0.06);
  white-space: normal;
}

.soon-card.upcoming {
  border-color: #dbe2ff;
  background: linear-gradient(180deg, #f7f8ff 0%, #ffffff 100%);
}

.soon-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.soon-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.soon-rel {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

.soon-when {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #eceef5;
  color: var(--muted);
  font-size: 20rpx;
}

.soon-when.on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.soon-line,
.soon-age {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.soon-age {
  color: var(--brand);
}

.scope-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 4rpx 0 20rpx;
}

.filter-nav {
  flex: none;
}

.scope-switch {
  display: inline-flex;
  background: #eceef5;
  border-radius: 999rpx;
  padding: 6rpx;
  gap: 4rpx;
}

.scope-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.scope-btn.on {
  background: #fff;
  color: var(--text);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(20, 20, 40, 0.06);
}

.gift-toolbar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 20rpx 0 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 40, 0.05);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 28rpx;
}

.search-clear {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  color: var(--muted);
  font-size: 36rpx;
  flex: none;
}

.kind-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.kind-pills {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pill-chip {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #eceef5;
  color: var(--muted);
  font-size: 24rpx;
}

.pill-chip.on {
  background: var(--brand-soft);
  color: var(--brand);
  font-weight: 600;
}

.filter-reset {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
  padding: 8rpx;
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-text {
  color: var(--muted);
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.empty-actions .btn + .btn {
  margin-top: 0;
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line);
}

.group-date {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.group-sum {
  font-size: 24rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  overflow: hidden;
  white-space: nowrap;
  flex: none;
}

.gift-title-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.occasion-badge {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
}

.rel-badge {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #eceef5;
  color: var(--muted);
  font-size: 22rpx;
}

.gift-sub {
  margin-top: 6rpx;
}

.gift-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.contact-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.contact-search {
  flex: 1;
  min-width: 0;
}

.contact-top-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: none;
}

.pill-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.pill-btn.primary {
  background: var(--brand);
  color: #fff;
}

.pill-btn.ghost {
  background: var(--brand-soft);
  color: var(--brand);
}

.contact-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand);
}

.contact-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex: none;
}

.quick-gift-btn {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
}

.arrow {
  color: var(--muted);
  font-size: 30rpx;
}

.ph {
  color: #b8b8bd;
}
