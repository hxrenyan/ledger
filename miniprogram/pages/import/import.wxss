.paste {
  width: 100%;
  /* textarea 同样显式定高，别只给 min-height：定高后内边距不会挤掉可视行数 */
  height: 320rpx;
  border: 1rpx solid #ececef;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.mark {
  font-size: 22rpx;
  color: #3b5bdb;
  background: #eef0ff;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  flex: none;
}

.imp-row {
  border: 1rpx solid #ececef;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
}

.imp-row.off {
  opacity: 0.55;
}

.imp-row.bad {
  border-color: #f6d5d5;
  background: #fffafa;
}

.imp-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.imp-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 2rpx solid #cfd3dc;
  text-align: center;
  line-height: 38rpx;
  font-size: 24rpx;
  color: #fff;
  flex: none;
}

.imp-check.on {
  background: #3b5bdb;
  border-color: #3b5bdb;
}

.imp-no {
  font-size: 22rpx;
  color: #8e8e93;
  min-width: 48rpx;
}

.imp-amount {
  flex: 1;
  min-width: 0;
  /* input 的高度必须显式给，否则字会被上下裁掉 */
  height: 72rpx;
  padding: 0;
  text-align: right;
  font-size: 34rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.imp-note {
  margin-top: 14rpx;
  height: 76rpx;
  padding: 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #ececef;
}

.imp-flag {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #e5484d;
}

.imp-select-all {
  display: flex;
  gap: 32rpx;
  padding-top: 12rpx;
}

.imp-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.imp-actions .btn {
  flex: 1;
  margin-top: 0;
}

/* 与 ai-panel 里那套 chips 保持一致（组件样式不外泄，页面里只能重写一份） */
.ap-dir {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eceef5;
  color: #556070;
  flex: none;
}

.ap-dir.expense {
  background: #ffe9e8;
  color: #e5484d;
}

.ap-dir.income {
  background: #e6f6ec;
  color: #1f9d55;
}

.ap-picks {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ap-picks > picker {
  flex: 1;
  min-width: 0;
}

.ap-pick {
  font-size: 24rpx;
  color: #3b5bdb;
  background: #eef0ff;
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ph {
  color: #b8b8bd;
}
