<web-view wx:if="{{webviewSrc}}" src="{{webviewSrc}}" binderror="onWebError"></web-view>
<view wx:else class="page">
  <view class="card" wx:for="{{announcements}}" wx:key="id">
    <view class="tool-name">{{item.title}}</view><view class="muted">{{item.body}}</view>
  </view>
  <view class="card guest-card" wx:if="{{guest}}">
    <view class="guest-title">登录后使用工具</view>
    <view class="muted">联系人和日子跟当前账本走。日历记事只属于自己</view>
    <button class="btn compact" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="card tool-card" bindtap="openContacts">
      <view class="tool-ico">人</view>
      <view class="tool-main">
        <view class="tool-name">联系人管理</view>
        <view class="muted">改姓名、关系和重要日子</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="card tool-card" bindtap="openCalendar">
      <view class="tool-ico">历</view>
      <view class="tool-main">
        <view class="tool-name">日历记录</view>
        <view class="muted">按天记下要办的事，只自己看得见</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </block>
  <view class="card tool-card" bindtap="openScore">
    <view class="tool-ico">分</view>
    <view class="tool-main"><view class="tool-name">记分</view><view class="muted">创建临时房间，邀请朋友一起加减分</view></view>
    <view class="arrow">›</view>
  </view>
</view>
