<view class="page">
  <view class="tabs">
    <view class="t {{tab === 'expense' ? 'on' : ''}}" data-t="expense" bindtap="switchTab">支出分类</view>
    <view class="t {{tab === 'income' ? 'on' : ''}}" data-t="income" bindtap="switchTab">收入分类</view>
  </view>

  <view class="card">
    <view class="empty" wx:if="{{loading}}">加载中…</view>
    <block wx:elif="{{tab === 'expense'}}">
      <view class="empty" wx:if="{{!expense.length}}">还没有支出分类</view>
      <view class="row" wx:for="{{expense}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategory">
        <view class="grow title">{{item.name}}<text wx:if="{{item.archived}}"> · 已归档</text></view>
        <view class="arrow">›</view>
      </view>
    </block>
    <block wx:else>
      <view class="empty" wx:if="{{!income.length}}">还没有收入分类</view>
      <view class="row" wx:for="{{income}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategory">
        <view class="grow title">{{item.name}}<text wx:if="{{item.archived}}"> · 已归档</text></view>
        <view class="arrow">›</view>
      </view>
    </block>
  </view>

  <view class="link-row">
    <view>显示已归档</view>
    <switch checked="{{showArchived}}" color="#3b5bdb" bindchange="toggleArchived" />
  </view>

  <button class="btn ghost" bindtap="add">新增{{tab === 'expense' ? '支出' : '收入'}}分类</button>
</view>
